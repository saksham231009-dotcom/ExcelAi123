# Copy to .env.local and fill in. Never commit .env.local or real keys.

# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=your-ai-provider-key
OPENAI_MODEL=your-model-id
# Leave unset for OpenAI; for AICredits use https://api.aicredits.in/v1
OPENAI_BASE_URL=

# Optional: only for tests/integration/rls.test.ts (two existing, confirmed test accounts)
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
